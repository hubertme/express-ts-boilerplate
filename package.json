{
  "name": "express-ts-boilerplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy:all",
    "pretest": "npm run build",
    "test": "mocha 'dist/test/**/*.js' --recursive --timeout 60000 --exit",
    "prestart": "npm test",
    "start": "node dist/bin/runtime.js",
    "start:dev": "npm run build && node dist/bin/runtime.js",
    "start:log": "nohup npm start > output.log",
    "copy:all": "npm run copy:keys && npm run copy:envs && npm run copy:views",
    "copy:keys": "cp -a keys/. dist/keys",
    "copy:envs": "cp -a envs/. dist/envs",
    "copy:views": "cp -a views/. dist/views"
  },
  "dependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.9",
    "cookie-parser": "~1.4.7",
    "debug": "~4.4.0",
    "dotenv": "^16.4.7",
    "express": "~4.21.2",
    "http-errors": "~2.0.0",
    "jade": "~1.11.0",
    "morgan": "~1.10.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/chai": "^5.0.1",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.0",
    "chai": "^5.1.2",
    "mocha": "^11.1.0",
    "mocha-junit-reporter": "^2.2.1",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^5.7.3"
  }
}
