{
  "name": "express-ts-boilerplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy:all",
    "test": "NODE_ENV=test TS_NODE_PROJECT=./test/tsconfig.json mocha -r ts-node/register 'test/**/*.ts' --timeout 60000 --exit",
    "prestart": "npm test",
    "start": "node dist/bin/runtime.js",
    "dev": "npm run build && node dist/bin/runtime.js",
    "start:log": "nohup npm start > output.log",
    "copy:all": "npm run copy:keys && npm run copy:envs && npm run copy:views",
    "copy:keys": "cp -a keys/. dist/keys",
    "copy:envs": "cp -a envs/. dist/envs",
    "copy:views": "cp -a views/. dist/views",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.9",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.5",
    "debug": "~4.4.0",
    "dotenv": "^16.3.1",
    "dotenv-safe": "^8.2.0",
    "express": "~4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^7.2.0",
    "http-errors": "~2.0.0",
    "morgan": "~1.10.0",
    "pug": "^3.0.2",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^5.0.1",
    "@types/chai-as-promised": "^8.0.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/dotenv-safe": "^8.1.6",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-serve-static-core": "^5.0.6",
    "@types/express-validator": "^2.20.33",
    "@types/helmet": "^0.0.48",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.2",
    "bcrypt": "^5.1.1",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "mocha": "^10.2.0",
    "mocha-junit-reporter": "^2.2.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "rimraf": "^5.0.5",
    "glob": "^10.3.10",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "typescript": "^5.7.3"
  }
}
