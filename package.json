{
  "name": "express-ts-boilerplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy:all",
    "pretest": "npm run build",
    "test": "mocha 'dist/test/**/*.js' --recursive --timeout 60000 --exit",
    "prestart": "npm test",
    "start": "node dist/bin/runtime.js",
    "start:dev": "npm run build && node dist/bin/runtime.js",
    "start:log": "nohup npm start > output.log",
    "copy:all": "npm run copy:keys && npm run copy:envs && npm run copy:views",
    "copy:keys": "cp -a keys/. dist/keys",
    "copy:envs": "cp -a envs/. dist/envs",
    "copy:views": "cp -a views/. dist/views"
  },
  "dependencies": {
    "axios": "^0.24.0",
    "cookie-parser": "^1.4.4",
    "debug": "^4.3.2",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "http-errors": "^1.8.0",
    "jade": "^1.11.0",
    "morgan": "^1.10.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/uuid": "^8.3.1",
    "@types/chai": "^4.2.22",
    "@types/express": "^4.17.13",
    "@types/mocha": "^9.0.0",
    "@types/node": "^16.11.6",
    "chai": "^4.3.4",
    "mocha": "^9.1.3",
    "mocha-junit-reporter": "^2.0.2",
    "ts-node": "^10.4.0",
    "tslint": "^6.1.2",
    "typescript": "^4.4.4"
  }
}
