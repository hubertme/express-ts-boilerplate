{
  "name": "express-ts-boilerplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy:all",
    "test": "NODE_ENV=test TS_NODE_PROJECT=./test/tsconfig.json mocha -r ts-node/register 'test/**/*.ts' --timeout 60000 --exit",
    "prestart": "npm test",
    "start": "node dist/bin/runtime.js",
    "dev": "npm run build && node dist/bin/runtime.js",
    "start:log": "nohup npm start > output.log",
    "copy:all": "npm run copy:keys && npm run copy:envs && npm run copy:views",
    "copy:keys": "cp -a keys/. dist/keys",
    "copy:envs": "cp -a envs/. dist/envs",
    "copy:views": "cp -a views/. dist/views",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "axios": "^1.9.0",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.5",
    "debug": "~4.4.1",
    "dotenv": "^16.5.0",
    "dotenv-safe": "^9.1.0",
    "express": "~5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "http-errors": "~2.0.0",
    "morgan": "~1.10.0",
    "pug": "^3.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tiny-csrf": "^1.1.6",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/dotenv-safe": "^8.1.6",
    "@types/express": "^5.0.1",
    "@types/express-serve-static-core": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.18",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "bcrypt": "^6.0.0",
    "chai": "^5.2.0",
    "chai-as-promised": "^8.0.1",
    "eslint": "^9.26.0",
    "glob": "^11.0.2",
    "mocha": "^11.2.2",
    "mocha-junit-reporter": "^2.2.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
