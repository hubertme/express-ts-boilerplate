{
  "defaultSeverity": "error",
  "extends": [
    "tslint:recommended"
  ],
  "jsRules": {
    "no-console": false
  },
  "rules": {
    "trailing-comma": [ false ],
    "no-console": false,
    "no-trailing-whitespace": false,
    "triple-equals": false,
    "max-classes-per-file": false
  },
  "rulesDirectory": []
}
