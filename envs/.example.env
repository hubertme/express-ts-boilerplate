PORT=3000
NODE_ENV=development
# CORS_ORIGIN can be a specific URL like http://localhost:3001, or * for permissive (use with caution)
# If CORS_ENABLED is false in config.ts, this value is ignored.
# If CORS_ENABLED is true and this is undefined/empty, CORS will be disabled (origin: false).
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# IMPORTANT: These keys MUST be set to strong, unique random values in your actual .env files
ENCRYPTION_KEY=your-secure-32-character-encryption-key1    # must be 32 characters (256 bits) for AES-256.
ENCRYPTION_IV=your-secure-16-character-iv-here1    # must be 16 characters (128 bits) for AES modes like CBC/GCM.
CSRF_SECRET=your-secure-32-character-csrf-secret1    # must be 32 characters (256 bits) for tiny-csrf.
